#!/bin/bash
set -e
source ./vars.sh

if [ "$R_BOOTLOADER" = "grub" ]; then
    echo "Installing GRUB..."
    pacman -S grub-efi-x86_64 efibootmgr --needed --noconfirm
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=arch_grub --recheck
    mkdir -p /boot/grub/locale
    cp /usr/share/locale/en@quot/LC_MESSAGES/grub.mo /boot/grub/locale/en.mo
    mypath=/etc/default/grub
    sed -i "s/#\?\(GRUB_DISABLE_OS_PROBER=false\)/\1/" "$mypath"
    grub-mkconfig -o /boot/grub/grub.cfg

elif [ "$R_BOOTLOADER" = "systemd" ]; then
    echo "Installing systemd-boot..."
    pacman -S systemd efibootmgr --needed --noconfirm
    bootctl install

    # Get the root partition UUID from fstab
    ROOT_UUID=$(awk '$2 == "/" {print $1}' /etc/fstab | grep -oP 'UUID=\K[^ ]+')

    mkdir -p /boot/loader/entries
    cat > /boot/loader/loader.conf <<EOF
default arch.conf
timeout 3
console-mode max
editor no
EOF

    cat > /boot/loader/entries/arch.conf <<EOF
title   Arch Linux
linux   /vmlinuz-linux
initrd  /${R_CPU}-ucode.img
initrd  /initramfs-linux.img
options root=UUID=${ROOT_UUID} rw
EOF

    cat > /boot/loader/entries/arch-fallback.conf <<EOF
title   Arch Linux (fallback)
linux   /vmlinuz-linux
initrd  /${R_CPU}-ucode.img
initrd  /initramfs-linux-fallback.img
options root=UUID=${ROOT_UUID} rw
EOF

else
    echo "ERROR: Invalid R_BOOTLOADER value: $R_BOOTLOADER (use 'grub' or 'systemd')"
    exit 1
fi
