#!/bin/bash
set -euo pipefail

# --- Configuração de partições ---
# Você pode passar as partições como argumentos ou editar aqui
swap_partition="${1:-/dev/sdc1}"
efi_partition="${2:-/dev/sdc2}"
btrfs_partition="${3:-/dev/sdc3}"

# systemd-boot requer que o ESP seja montado em /boot
efi_mount=/mnt/boot

# --- Verificação de segurança ---
echo "=== Verificação de Partições ==="
echo "Swap:  $swap_partition"
echo "EFI:   $efi_partition"
echo "Btrfs: $btrfs_partition"
echo ""

# Verificar se os dispositivos existem
for dev in "$swap_partition" "$efi_partition" "$btrfs_partition"; do
    if [ ! -b "$dev" ]; then
        echo "ERRO: Dispositivo $dev não existe!"
        exit 1
    fi
done

# Confirmação do usuário
read -p "AVISO: Isso irá FORMATAR e APAGAR todos os dados nestas partições! Continuar? (digite 'SIM' em maiúsculas): " confirm
if [ "$confirm" != "SIM" ]; then
    echo "Operação cancelada."
    exit 0
fi

# --- Limpa as partições ---
echo "Limpando partições..."
wipefs -a "$swap_partition"
wipefs -a "$efi_partition"
wipefs -a "$btrfs_partition"

# --- Formatação ---
echo "Formatando partições..."
mkfs.btrfs -f -L rootfs "$btrfs_partition"
mkfs.fat -F 32 -n EFI "$efi_partition"
mkswap -L swap "$swap_partition"

# --- Montar temporariamente o Btrfs bruto ---
echo "Criando subvolumes Btrfs..."
mount "$btrfs_partition" /mnt

# --- Criar subvolumes ---
btrfs subvolume create /mnt/@
btrfs subvolume create /mnt/@home
btrfs subvolume create /mnt/@snapshots
btrfs subvolume create /mnt/@log

umount /mnt

# --- Opções modernas recomendadas ---
opts="noatime,compress=zstd:3,ssd,space_cache=v2,discard=async"

# --- Montar o subvolume raiz ---
echo "Montando subvolumes..."
mount -o $opts,subvol=@ "$btrfs_partition" /mnt

# --- @home ---
mkdir -p /mnt/home
mount -o $opts,subvol=@home "$btrfs_partition" /mnt/home

# --- @snapshots ---
mkdir -p /mnt/.snapshots
mount -o $opts,subvol=@snapshots "$btrfs_partition" /mnt/.snapshots

# --- @log ---
mkdir -p /mnt/var/log
mount -o $opts,subvol=@log "$btrfs_partition" /mnt/var/log

# --- EFI (para systemd-boot, deve ser /boot) ---
mkdir -p "$efi_mount"
mount "$efi_partition" "$efi_mount"

# --- Swap ---
echo "Ativando swap..."
swapon "$swap_partition"

echo ""
echo "=== Btrfs layout criado e partições montadas com sucesso! ==="
echo "Estrutura de montagem:"
echo "  /mnt          -> @ (root)"
echo "  /mnt/home     -> @home"
echo "  /mnt/.snapshots -> @snapshots"
echo "  /mnt/var/log  -> @log"
echo "  /mnt/boot     -> EFI System Partition"
echo "  swap ativo    -> $swap_partition"
